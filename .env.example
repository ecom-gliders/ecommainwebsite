# Canonical site URL (set to Vercel preview URL on staging, https://ecomgliders.com in production)
NEXT_PUBLIC_SITE_URL=https://ecomgliders.com

# Optional: server-side alias for sitemap/robots generation
# SITE_URL=https://ecomgliders.com

# Hostinger SMTP (mailbox: info@ecomgliders.com)
# Docs: smtp.hostinger.com · SSL 465 (default) · or STARTTLS 587 with SMTP_SECURE=false
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@ecomgliders.com
# SMTP_PASS=

# Team inbox for every lead form + newsletter (defaults to info@ecomgliders.com)
FORM_NOTIFICATION_EMAIL=info@ecomgliders.com
FORM_FROM_EMAIL=eCom Gliders <info@ecomgliders.com>

# Discord — branded embeds (never commit real webhook URLs)
# Full funnel (multi-step Free Audit) + contact / careers / partnership / newsletter:
# DISCORD_FORM_WEBHOOK_URL=
# Short Get in Touch forms (homepage hero + service page lead forms):
# DISCORD_GET_IN_TOUCH_WEBHOOK_URL=

# Beehiiv newsletter — iframe embed only (no API required)
# Optional override of the default embed URL
# Slim iframe embed (?slim=true appended in FooterNewsletter). Base URL only:
# NEXT_PUBLIC_BEEHIIV_EMBED_URL=https://embeds.beehiiv.com/b67089b0-4fe7-450e-bf60-7cb7fbc1e708

# Brand images for Discord embeds (emails attach logo inline — no remote fetch).
# Live ecomgliders.com still serves Logoipsum at /images/logo.png until DNS cutover.
# BRAND_ASSET_ORIGIN=https://ecom-gliders.vercel.app

