# Dependencies / build
node_modules/
dist/
build/
.next/
.nuxt/
.output/
.cache/
*.tsbuildinfo

# Environment / secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
auth.json

# IDE
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Playwright / browser automation artifacts
.playwright-mcp/
test-results/
playwright-report/

# Logs
*.log
npm-debug.log*

# Vercel local link / deploy cache
.vercel/

# Large site backup payloads (local only)
backup/pages/
backup/blog/
backup/blog-mdx-sanitize/
backup/assets/
backup/raw/
backup/scrape-log.txt

# Temporary / scratch
tmp/
temp/
*.tmp
tmp-*.js
tmp-*.mjs
/tmp-*.js
/tmp-*.mjs

# Root one-off dumps (use assets/source/ instead)
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.gif

# Agent skill install mirrors (canonical copies live under .cursor/skills/)
.agents/
skills-lock.json

# Live WP export payloads (large)
wordpress-blog-export/

# Scratch migration / QA loops (keep intentional scripts under scripts/)
scripts/migration/_*.mjs
scripts/migration/_*.js
docs/ai/_*.json
docs/qa/screenshots/
docs/qa/live-*.png
docs/qa/vercel-*.png

# Obsidian local UI state only (vault notes stay tracked)
.obsidian/workspace.json
.obsidian/workspace-mobile.json
obsidian/.obsidian/workspace.json
obsidian/.obsidian/workspace-mobile.json
