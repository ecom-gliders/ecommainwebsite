{
  "version": 1,
  "allowlistOnly": true,
  "rehypeRaw": false,
  "canonical": {
    "multiColumnChart": {
      "fence": "chart-cards",
      "component": "BlogChartCards",
      "rule": "When rows include percentages, render column bars plus secondary notes (e.g. cost). Do not use plain text-only cards for Chart: captions.",
      "examplePost": "2025-amazon-algorithm-updates-what-sellers-need-to-know"
    },
    "singleSeriesBars": {
      "fence": "bar-chart",
      "component": "BlogBarChart",
      "rule": "Use for explicit numeric series with ORIENTATION vertical|horizontal."
    },
    "figure": {
      "fence": "figure",
      "component": "BlogFigure",
      "also": "Markdown images (![]()) render with the same ink-border figure frame; title attribute becomes caption.",
      "frame": "aspect-16/9, border-2 primary, hard shadow"
    },
    "video": {
      "fence": "video-card",
      "component": "BlogVideoCard",
      "rule": "YouTube and Vimeo URLs embed in-page by default (MODE: embed). Other hosts use MODE: link with poster. No raw iframes in MDX.",
      "allowlistedHosts": ["youtube.com", "youtu.be", "youtube-nocookie.com", "vimeo.com", "player.vimeo.com"]
    }
  },
  "blocks": [
    {
